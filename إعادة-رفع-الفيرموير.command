#!/bin/bash
# إعادة رفع الفيرموير مباشرة (بدون إعادة تثبيت شيء) — يستخدم عندما يفشل
# الرفع بخطأ "port is busy" لتشخيص من يستخدم المنفذ وإعادة المحاولة.
set -e
cd "$(dirname "$0")/firmware/haptic-band-esp32c3"

PORT="/dev/cu.usbmodem1101"

echo "═══════════════════════════════════════════"
echo "   إعادة رفع الفيرموير"
echo "═══════════════════════════════════════════"

echo ""
echo "١) من يستخدم المنفذ $PORT حاليًا؟"
lsof "$PORT" 2>/dev/null || echo "   (لا شيء ظاهر يستخدمه عبر lsof — قد يكون انشغال مؤقت من النظام)"

echo ""
echo "٢) إعادة المحاولة بعد 3 ثوانٍ..."
sleep 3
arduino-cli upload -p "$PORT" --fqbn esp32:esp32:XIAO_ESP32C3 .

echo ""
echo "═══════════════════════════════════════════"
echo " تم رفع فيرموير v1.2.1 بنجاح على السوار!"
echo "═══════════════════════════════════════════"
read -p "اضغط Enter للإغلاق..."
