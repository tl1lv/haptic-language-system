#!/bin/bash
# رفع آخر تعديلات الكود (قناة لكل خطوة + إصلاحات الفيرموير) إلى GitHub
set -e
cd "$(dirname "$0")"

echo "═══════════════════════════════════════════"
echo "   رفع التحديثات إلى GitHub"
echo "═══════════════════════════════════════════"

echo ""
echo "١) حفظ التغييرات..."
git add -A
git commit -m "قناة اهتزاز لكل خطوة + إصلاح شدة 100 والاهتزاز الضعيف واندماج النبضتين" || echo "   لا توجد تغييرات جديدة للحفظ"

echo ""
echo "٢) رفع إلى GitHub..."
git push origin main

echo ""
echo "═══════════════════════════════════════════"
echo " تم! التحديثات الآن على GitHub."
echo " تذكير مهم:"
echo " • أعد رفع فيرموير الـ ESP32C3 المحدث (v1.2.0) من مجلد firmware"
echo "   عبر Arduino IDE — يحتوي إصلاح الشدة 100 والاهتزاز الضعيف واندماج النبضتين."
echo " • بعد ذلك أعد تشغيل npm run dev وأعد توصيل السوار من صفحة"
echo "   'الأجهزة المتصلة' ليأخذ التطبيق البروتوكول الجديد."
echo "═══════════════════════════════════════════"
read -p "اضغط Enter للإغلاق..."
